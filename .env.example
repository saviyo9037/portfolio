# Optional. Everything works without this file: public repositories are read
# without a token. A token only raises GitHub's rate limit (60 -> 5000/hour).
#
# Server-side only. Never prefix these with VITE_ or NEXT_PUBLIC_.
#
# Create a fine-grained token at github.com/settings/personal-access-tokens
# with "Only select repositories" -> none needed, or "Public repositories
# (read-only)". No write permissions at all.
GITHUB_TOKEN=

# Set to true only if you want PRIVATE repos listed (also needs a token with
# read access to them). Private repos show without a link. Default: false.
GITHUB_INCLUDE_PRIVATE=false
